#!/usr/bin/env bash
# Starts the Vite dev server (storefront + admin + API middleware, one port).
# Runs for the whole session; killed on project close.
set -euo pipefail

cd "$(dirname "$0")/../.."

# Load PORT / FIGMA_MAKE_URL so the server binds the same port the host opens.
set -a
# shellcheck disable=SC1091
source "$(dirname "$0")/env"
set +a

export PORT
exec pnpm dev --port "$PORT" --host
