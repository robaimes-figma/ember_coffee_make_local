#!/usr/bin/env bash
# Confirms the dev server is reachable on the expected port.
set -euo pipefail

cd "$(dirname "$0")/../.."

# shellcheck disable=SC1091
source "$(dirname "$0")/env"

URL="http://localhost:${PORT}"

# Poll for up to ~60s; Vite's first cold start compiles on demand.
for i in $(seq 1 60); do
  if curl -fsS -o /dev/null "$URL"; then
    echo "verify: $URL is up"
    exit 0
  fi
  sleep 1
done

echo "verify: $URL did not respond in time" >&2
exit 1
